{
  "expectation_suite_name": "curated.weather_basic",
  "data_asset_type": "Dataset",
  "meta": {
    "description": "Curated Open-Meteo daily weather contracts. Loaded by rainlift.quality.suites / run_ge.py; covered by offline pytest."
  },
  "expectations": [
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "year" }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "month" }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "precipitation_sum" }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "precipitation_sum",
        "min_value": 0,
        "strict_min": false
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "year",
        "value_set": [2024]
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "month",
        "value_set": [1]
      }
    },
    {
      "expectation_type": "expect_table_row_count_to_be_between",
      "kwargs": {
        "min_value": 28,
        "max_value": 31
      }
    }
  ]
}
