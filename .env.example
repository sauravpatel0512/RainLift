# RainLift — copy to `.env` and adjust. Never commit real secrets.
# Host-side `make ingest|curate|quality|mart` use localhost below.
# Inside Compose, Trino/MinIO/Nessie talk via service DNS (see docker-compose.yml
# and configs/trino/catalog/iceberg.properties). Streamlit hardcodes TRINO_HOST=trino.

# MinIO (S3-compatible) — host Python clients
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_dev_change_me
MINIO_ENDPOINT=http://localhost:9000
MINIO_CONSOLE_PORT=9001
RAW_BUCKET=raw
CURATED_BUCKET=curated

# AWS-style keys for boto3 / PyIceberg / Trino S3 (match MinIO root user)
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio_dev_change_me
AWS_REGION=us-east-1
S3_PATH_STYLE_ACCESS=true

# Project Nessie (Iceberg REST catalog) — host Python
NESSIE_URI=http://localhost:19120/api/v1

# MongoDB — host Python
MONGO_URI=mongodb://localhost:27017
MONGO_DB=rainlift

# Trino — host Python uses published port (default 8088). Inside Compose always 8080.
TRINO_HOST=localhost
TRINO_PORT=8088
TRINO_HOST_PORT=8088
TRINO_USER=rainlift

# Fixed ingestion window (single month — spec)
TLC_MONTH=2024-01
TLC_PARQUET_URL=https://d37ci6vzurychx.cloudfront.net/trip-data/yellow_tripdata_2024-01.parquet
TAXI_ZONE_LOOKUP_URL=https://d37ci6vzurychx.cloudfront.net/misc/taxi_zone_lookup.csv

# Open-Meteo (no API key)
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
WEATHER_LAT=40.7128
WEATHER_LON=-74.006

# PyIceberg warehouse prefix inside curated bucket
ICEBERG_WAREHOUSE=s3://curated/wh/
